PORT=2000
NODE_ENV=development
# Redis Configuration (Required for Read Model)
# Can provide a full URL or host + port combination
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Keycloak Authentication
KEYCLOAK_URL=http://localhost:8085
KEYCLOAK_ISSUER=http://localhost:8085/realms/pixpro-realm
KEYCLOAK_REALM=pixpro-realm
KEYCLOAK_CLIENT_ID=pixpro-backend-client

# RabbitMQ Event Broker
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EXCHANGE=pixpro.events
RABBITMQ_EXCHANGE_TYPE=topic
